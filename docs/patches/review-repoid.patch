Review fix (T8, test_review_repoid.py): normalize_remote kept query strings, and userinfo in scp form.

A token passed as ?private_token=... survived into the repo id (and so into the memory directory's name and
repo.json). An scp-form remote whose password contains '@' (user:p@ss@host:owner/repo) put part of the password
into the host. Now the query and fragment are dropped first, and scp form splits userinfo at the last '@'
before the host. Adds tests/review/test_review_repoid_userinfo.py for the second case.

Apply from the repo root: git apply docs/patches/review-repoid.patch

--- a/src/honeyguide/repoid.py
+++ b/src/honeyguide/repoid.py
@@ -8,7 +8,7 @@
 from .gitio import Repo
 
 _SCHEMES = ("git+ssh://", "ssh+git://", "ssh://", "https://", "http://", "git://")
-_SCP = re.compile(r"^(?:[^@/]+@)?([^:/]+):(?!//)(.+)$")  # git@github.com:owner/repo(.git)
+_SCP = re.compile(r"^(?:[^/]*@)?([^@:/]+):(?!//)(.+)$")  # git@github.com:owner/repo(.git); userinfo to the last @
 _CASE_INSENSITIVE_HOSTS = {"github.com"}
 
 
@@ -17,7 +17,7 @@
 
     Drops scheme, credentials, port, ``.git`` and trailing slashes; never returns a password or token.
     """
-    url = url.strip()
+    url = re.split(r"[?#]", url.strip(), maxsplit=1)[0]  # a query or fragment can carry a token
     if not url:
         return None
     lowered = url.lower()
--- /dev/null
+++ b/tests/review/test_review_repoid_userinfo.py
@@ -0,0 +1,16 @@
+"""Review (T8): normalize_remote never keeps userinfo, in any form."""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
+from honeyguide.repoid import normalize_remote  # noqa: E402
+
+
+def test_scp_password_with_at_sign_is_dropped():
+    assert normalize_remote("user:p@ss@github.com:Owner/Repo.git") == "github.com/owner/repo"
+
+
+def test_https_userinfo_query_and_fragment_are_dropped():
+    assert normalize_remote("https://u:t0ken@gitlab.example.com/g/r.git#frag") == "gitlab.example.com/g/r"
+    assert normalize_remote("git@github.com:o/r.git?x=1") == "github.com/o/r"
